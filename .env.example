MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=patent
MYSQL_PASSWORD=patent_dev
MYSQL_DATABASE=patent_valuation

# DeepSeek（OpenAI 兼容，启用后 Agent1/2 使用 method=llm）
# 密钥: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=sk-你的DeepSeek密钥
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 若 deepseek-chat 报错，可改为 deepseek-v4-flash 或 deepseek-v4-pro

# 其它 OpenAI 兼容服务可只改下面三行，例如 OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
